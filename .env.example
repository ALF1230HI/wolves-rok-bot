# Copy this file to ".env" and fill in your real values. Never share your bot token publicly.

DISCORD_BOT_TOKEN=your-bot-token-here

# Optional: your Discord server (guild) ID, for instant slash command sync during testing.
# Leave blank to sync globally (can take up to an hour to appear the first time).
# If the bot is in more than one server, use GUILD_IDS instead with a comma-separated
# list, e.g. GUILD_IDS=1386443294644633721,1513550074473480394
GUILD_ID=
GUILD_IDS=

# --- Google Sheets (for /donate) ---
# Path to the service account JSON key file downloaded from Google Cloud Console.
# Use this when running locally / anywhere you can drop a file next to the bot.
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Alternative to GOOGLE_CREDENTIALS_PATH: paste the ENTIRE contents of the
# service account JSON key file as a single-line value here instead. Use this
# on hosts like Railway where you can't upload a file — set it as a normal
# environment variable in the Railway dashboard. If both are set, this one
# takes priority.
GOOGLE_CREDENTIALS_JSON=

# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# This is only the DEFAULT/fallback sheet, used for any server that hasn't run
# /config yet. Each Discord server can override this for itself with /config —
# see the "Multi-server /config" section in README.md.
DONATIONS_SHEET_ID=1spszkPihGZ9IIbe_v3Q2KtEai2awX1JITRxE09EzY4E

# The tab name at the bottom of the spreadsheet that has the donation table.
DONATIONS_TAB_NAME=Donations

# --- Multi-server /config (private operator dashboard) ---
# The ID of a PRIVATE Google Sheet only you (the bot operator) can view. It
# stores every Discord server's /config settings (their donations sheet ID,
# tab names, bank name, announce channel) in a "Server Configs" tab, so you
# can see what every server using your bot is doing from one place. Buyers
# never see or interact with this sheet directly.
#
# To set this up:
#   1. Create a new blank Google Sheet from your own Google account.
#   2. Share it with your bot's service account email (Editor access) — find
#      the email in your google_credentials.json file's "client_email" field.
#   3. Rename its first tab to "Server Configs" with this header row:
#      Guild ID | Guild Name | Added On (UTC) | Configured By |
#      Donations Sheet ID | Donations Tab Name | Alliance Members Tab Name |
#      Bank Name | Announce Channel ID | Last Updated (UTC)
#   4. Paste the sheet's ID below.
MASTER_CONFIG_SHEET_ID=
MASTER_CONFIG_TAB_NAME=Server Configs
