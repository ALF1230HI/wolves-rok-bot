# Copy this file to ".env" and fill in your real values. Never share your bot token publicly.

DISCORD_BOT_TOKEN=your-bot-token-here

# Optional: your Discord server (guild) ID, for instant slash command sync during testing.
# Leave blank to sync globally (can take up to an hour to appear the first time).
GUILD_ID=

# --- Google Sheets (for /donate) ---
# Path to the service account JSON key file downloaded from Google Cloud Console.
# Use this when running locally / anywhere you can drop a file next to the bot.
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Alternative to GOOGLE_CREDENTIALS_PATH: paste the ENTIRE contents of the
# service account JSON key file as a single-line value here instead. Use this
# on hosts like Railway where you can't upload a file — set it as a normal
# environment variable in the Railway dashboard. If both are set, this one
# takes priority.
GOOGLE_CREDENTIALS_JSON=

# The spreadsheet ID from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
DONATIONS_SHEET_ID=1spszkPihGZ9IIbe_v3Q2KtEai2awX1JITRxE09EzY4E

# The tab name at the bottom of the spreadsheet that has the donation table.
DONATIONS_TAB_NAME=Donations
